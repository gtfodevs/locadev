# locadev consumer contract
# -------------------------
# Copy only the vars YOUR repo uses into the client app's .env / appsettings.
# Names differ per stack (C# "Section:Key" vs Python UPPER_SNAKE) — the VALUES matter.
# Run the client on the same host as Docker Desktop (or Linux Engine).
# Moving to a real cloud sandbox later is a value swap with no code change.

# === Azurite (blob / queue / table) ===
# Python azure-storage-blob needs this FULL string; UseDevelopmentStorage=true is not enough.
# Host ports: blob 10000, queue 10101 (not 10001), table 10002.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10101/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

# === Azure Functions (storage bindings → same Azurite) ===
# Use for `func start` on the host, or any Functions host outside compose.
# Profile `functions` also runs a sample host at http://127.0.0.1:7071 (see sample_azure_functions/).
AzureWebJobsStorage=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10101/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;
FUNCTIONS_WORKER_RUNTIME=node
# From another container on network locadev, use azurite:10000 / :10001 / :10002 instead of 127.0.0.1:10101.

# === Service Bus emulator ===
# Declared entities (infra/Config.json): app-work-queue, dev-ingestion-queue,
# topics emailrequest (+ emailrequest-sub), app-events (+ app-events-sub).
# Requires azure-servicebus >= 7.13.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# === Azure OpenAI / Foundry bridge ===
# API key is ignored; deployment names pass through as-is.
AZURE_OPENAI_ENDPOINT=http://127.0.0.1:8090
AZURE_OPENAI_API_KEY=not-used
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-ada-002

# === PGlite (app SQL) — NOT the Service Bus internal MSSQL ===
PGLITE_HTTP_URL=http://127.0.0.1:5433
# Optional PG-wire (only if gateway enabled in a future release):
# DATABASE_URL=postgresql://locadev:locadev@127.0.0.1:5432/locadev

# === Redis ===
# From host:
REDIS_URL=redis://127.0.0.1:6380
# From containers on locadev network:
# REDIS_URL=redis://redis:6379

# === Topaz (app-level RBAC stand-in; not Entra) ===
TOPAZ_URL=http://127.0.0.1:8484
# POST /api/v2/authz/is  — fail closed on errors

# === Cosmos (profile: cosmos) — HTTP gateway on 8081 ===
COSMOS_ENDPOINT=http://127.0.0.1:8081
# Well-known emulator key:
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# === AWS S3 via MiniStack (profile: aws) ===
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=locadev-demo

# === Key Vault (profile: kv) — most apps fall back to env ===
USE_KEY_VAULT=false
# KEY_VAULT_URL=https://127.0.0.1:8443

# === AI Search emulator (profile: search) ===
AZURE_SEARCH_ENDPOINT=http://127.0.0.1:8800
AZURE_SEARCH_API_KEY=not-used

# === Fake SendGrid (profile: mail) ===
SENDGRID_API_KEY=not-used
SENDGRID_BASE_URL=http://127.0.0.1:8095
# Assert captured mail: GET http://127.0.0.1:8095/captured

# === Fake Slack (profile: slack) ===
# Point slack SDK base URL / custom client at this host when supported.
SLACK_API_BASE=http://127.0.0.1:8096
SLACK_BOT_TOKEN=xoxb-locadev-not-used
# See messages: http://127.0.0.1:8096/ui  and  GET /messages
# Web API: POST /api/chat.postMessage , /api/conversations.history , /api/inject

# === Fake Discord (profile: discord) ===
DISCORD_API_BASE=http://127.0.0.1:8097
DISCORD_BOT_TOKEN=locadev-not-used
# See messages: http://127.0.0.1:8097/ui  and  GET /messages
# REST: POST /api/v10/channels/{id}/messages , GET .../messages , POST /api/inject

# === fake-teams (profile: teams) ===
FAKE_TEAMS_BASE=http://127.0.0.1:3979
# See messages: GET http://127.0.0.1:3979/api/messages

# === Work boards (Jira + Azure DevOps) — host agent tooling, not Docker ===
# Config (no secrets): cp boards/config.example.json .grok/local/boards.json
# CLI: ./boards/board.sh providers | get | comment | transition | search | url
# LOCADEV_BOARD_CONFIG=.grok/local/boards.json
# LOCADEV_BOARD_PROVIDER=jira
# Jira Cloud API token (https://id.atlassian.com/manage-profile/security/api-tokens):
# JIRA_API_TOKEN=
# Azure DevOps PAT — Work Items Read & Write (az boards uses same name):
# AZURE_DEVOPS_EXT_PAT=
# Citation tokens for hooks: jira:PROJ-123  or  ado:#42

# --- Cloudflare Workers (profile: cloudflare, host :8787) ---
# Default builds sample_cloudflare_worker. Override for GigChain auth:
#   CLOUDFLARE_WORKER_DIR=../gigchain/auth ./scripts/start.sh cloudflare
# CLOUDFLARE_WORKER_DIR=./sample_cloudflare_worker
# ISSUER=http://127.0.0.1:8787
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_SUCCESS_REDIRECT=http://127.0.0.1:3000

# --- OAuth fakes (profile: oauth, host :8098) ---
# Use with GigChain auth URL overrides (see fake_oauth/README.md).
# From the Docker host / browser:
#   GITHUB_AUTHORIZE_URL=http://127.0.0.1:8098/login/oauth/authorize
#   GITHUB_TOKEN_URL=http://127.0.0.1:8098/login/oauth/access_token
#   GITHUB_USERINFO_URL=http://127.0.0.1:8098/user
#   GITHUB_EMAILS_URL=http://127.0.0.1:8098/user/emails
#   GOOGLE_AUTHORIZE_URL=http://127.0.0.1:8098/o/oauth2/v2/auth
#   GOOGLE_TOKEN_URL=http://127.0.0.1:8098/token
#   GOOGLE_USERINFO_URL=http://127.0.0.1:8098/v1/userinfo
# From another compose service, swap 127.0.0.1 → fake-oauth
# GITHUB_CLIENT_ID=local-github
# GITHUB_CLIENT_SECRET=local-github-secret
# GOOGLE_CLIENT_ID=local-google
# GOOGLE_CLIENT_SECRET=local-google-secret

# TOTP / soft passkey helpers (same fake-oauth service on :8098)
# POST http://127.0.0.1:8098/totp/enroll   {"user_id":"alice"}
# GET  http://127.0.0.1:8098/totp/code?user_id=alice
# POST http://127.0.0.1:8098/passkey/register {"user_id":"alice"}
